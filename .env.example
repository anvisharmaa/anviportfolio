# Copy this file to ".env" for local development (never commit the real .env).
# In production, set these in the Netlify dashboard:
#   Site settings → Environment variables

# Your free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model. Defaults to openai/gpt-oss-20b (free tier, fast).
# See https://console.groq.com/docs/models for current model IDs.
# GROQ_MODEL=openai/gpt-oss-20b
